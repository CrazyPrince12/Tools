# ---------------------------------------------------------------------------
# Venice v2 — configuration de la passerelle (chat.dphn.ai)
#
# Copiez ce fichier en .env (ignoré par git). Aucun secret n'est requis :
# l'accès à Dolphin repose sur les cookies Cloudflare obtenus automatiquement
# par Chromium headless. En production, ces variables se définissent dans le
# dashboard Render (ou avec docker run -e).
# ---------------------------------------------------------------------------

# --- Cible -----------------------------------------------------------------
# DOLPHIN_BASE_URL=https://chat.dphn.ai
# L'User-Agent doit être identique pour le navigateur headless et les appels
# HTTP : Cloudflare lie `cf_clearance` à l'empreinte (IP + UA).
# DOLPHIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# --- Session Cloudflare ----------------------------------------------------
# Cookie injecté à la main (dépannage / dev sans navigateur). Exemple :
# DOLPHIN_COOKIE=cf_clearance=xxxxx; __cf_ob=yyyyy
# DOLPHIN_COOKIE=
# Durée de vie estimée avant rafraîchissement préventif (ms, défaut 20 min).
# DOLPHIN_COOKIE_TTL_MS=1200000
# Intervalle de la boucle de rafraîchissement (ms, défaut 12 min).
# DOLPHIN_REFRESH_INTERVAL_MS=720000
# Rafraîchir dès le démarrage du serveur (défaut 1).
# DOLPHIN_REFRESH_ON_BOOT=1

# --- Solveur (Chromium headless) -------------------------------------------
# playwright (défaut) ou none (uniquement DOLPHIN_COOKIE).
# DOLPHIN_SOLVER=playwright
# Module à charger : "playwright" par défaut, "patchright" si Cloudflare durcit.
# PLAYWRIGHT_MODULE=playwright
# DOLPHIN_SOLVER_HEADLESS=1
# DOLPHIN_SOLVER_TIMEOUT_MS=90000
# DOLPHIN_LOCALE=fr-FR
# DOLPHIN_TIMEZONE=Europe/Paris

# --- Payload amont ---------------------------------------------------------
# auto (défaut) : tente role=system, dégrade tout seul si Dolphin refuse.
# system | message | none forcent la stratégie.
# DOLPHIN_SYSTEM_MODE=auto
# Champs supplémentaires ajoutés au corps de /api/chat (JSON, optionnel).
# DOLPHIN_EXTRA_BODY={"temperature":0.7}

# --- Débit et robustesse ---------------------------------------------------
# VENICE_RATE_LIMIT=30           # requêtes /api/chat par minute et par IP (0 = illimité)
# DOLPHIN_REQUEST_TIMEOUT_MS=30000
# DOLPHIN_STREAM_IDLE_MS=60000   # coupure si le flux n'émet plus rien
# DOLPHIN_STREAM_TOTAL_MS=600000
# DOLPHIN_RETRIES=1
# DOLPHIN_CATALOG_TTL_MS=600000

# --- Interface -------------------------------------------------------------
# Historique local du navigateur (transmis à l'interface via /api/health).
# VENICE_CONTEXT_WINDOW=20       # messages envoyés au modèle
# VENICE_STORED_MESSAGES=80      # messages conservés par conversation
# VENICE_MAX_CONVERSATIONS=60    # conversations conservées dans le navigateur

# Mode démo : réponses simulées, aucun appel sortant.
# DEMO_MODE=0

# Base de données PostgreSQL Neon (obligatoire en production sur Render)
# Exemple : postgresql://neondb_owner:password@ep-xyz-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Jeton requis par POST /api/session/refresh (la route est fermée si vide).
# ADMIN_TOKEN=changez-moi

# PORT=3000
# HOST=0.0.0.0
